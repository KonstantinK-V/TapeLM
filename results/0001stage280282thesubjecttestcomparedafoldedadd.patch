From 13536ef46e863e02d4bdbfeefb839e01bd9c93e8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 7 Aug 2026 02:57:40 +0000
Subject: [PATCH] stage 280/282: the subject test compared a folded address
 against unfolded text

An address is lowercased when it is written - 279 builds it from
name.lower() - and the context goes onto the tape exactly as it appeared
in the corpus. Every 'does this slot mention the subject' test is a
substring test between the two, so it was False for every capitalised
name, which is every entity: 'tommy lawton' is not in 'Tommy Lawton was
born in Bolton'.

Two things were reading that test. The probe's return path, which is why
probe_hit_rate stayed 0.000 even after the probe got its own index -
the second smoke shows the teacher asking both leaders on a tie, getting
a miss from both by construction, and calling STOP_CONFLICT on all nine
held-out clean addresses. And --subject-filter, whose 'own or cands'
fallback turned an empty result into the unfiltered list, so the filter
has been a silent no-op on raw text since 280 began - which is some of
the retrieval pollution that made those false ties in the first place.

The pack now carries a folded copy of each text and both readers use it.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01PGuqHAMhjCxVAADm3R4wxK
---
 _stage280_raw_exam.py | 7 ++++++-
 _stage282_mind.py     | 2 +-
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/_stage280_raw_exam.py b/_stage280_raw_exam.py
index 9b19e58..81506fb 100644
--- a/_stage280_raw_exam.py
+++ b/_stage280_raw_exam.py
@@ -192,6 +192,11 @@ def pack_from_corpus(lines, *, bank, tok, pad_id, device, rng, n_addr, min_menti
         "tape": TapeView(torch.stack(keys, 0).to(device), vals, tok, pad_id),
         "texts": texts, "items": items, "postings": postings, "idf": idf,
         "postings_probe": postings_probe, "idf_probe": idf_probe,
+        # An address is lowercased when it is written (279 builds addr from name.lower()); the
+        # context is stored as it was in the corpus. Every test of the form "does this slot
+        # mention the subject" is a substring test between the two, so it answered False for
+        # every capitalised name - which is every entity. Both readers take the folded text.
+        "texts_lc": [t.lower() for t in texts],
         "addr_keys": (F.normalize(torch.stack(akey).float(), dim=-1).to(device)
                       if akey else None),
         "addr_slots": aslots, "bank": bank,
@@ -238,7 +243,7 @@ def retrieve(pack, words, k, hop: str, item=None, subject_filter=False, hop_min=
             cands = (cands + extra)[:k]
             used_hop = True
     if subject_filter and item is not None and cands:
-        own = [c for c in cands if item["S"] in pack["texts"][c]]
+        own = [c for c in cands if item["S"] in pack["texts_lc"][c]]
         cands = own or cands
     if k_gap > 0.0 and cands:
         # A fixed k hands the reader whatever fills the list. On templates every slot in it
diff --git a/_stage282_mind.py b/_stage282_mind.py
index ab08125..07b4569 100644
--- a/_stage282_mind.py
+++ b/_stage282_mind.py
@@ -367,7 +367,7 @@ def rollout(policy, model, char_table, tok, pack, item, pad_id, device, acts, *,
             val_words = context_words(pack["tape"].values[slot]) or [pack["tape"].values[slot]]
             back, _, _ = s280.retrieve(pack, val_words, k, hop, None, False, hop_min, k_gap,
                                        index="probe")
-            st["ret_ok"][slot] = float(any(item["S"] in pack["texts"][c] for c in back))
+            st["ret_ok"][slot] = float(any(item["S"] in pack["texts_lc"][c] for c in back))
             st["cands"], st["sc"] = keep_c, keep_s
             st["probes"] += 1
         elif acts.DROP <= a < acts.DROP + acts.w:

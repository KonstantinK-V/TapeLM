+        "foreign_member_rate": m(foreign), "k_covers_address": m(k_covers),
         "return_path_true": m(ret_true), "return_path_other": m(ret_other),
         "return_path_separation": m(ret_true) - m(ret_other),
         "nearest_other_q": q(near, 50, 95, 99),

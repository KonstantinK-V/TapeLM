@@ -281,6 +296,8 @@ def main() -> int:
             "precision": [r["retrieval_precision"] for r in out_rungs],
             "return_path_separation": [r["return_path_separation"] for r in out_rungs],
             "address_crowding": [r["address_crowding"] for r in out_rungs],

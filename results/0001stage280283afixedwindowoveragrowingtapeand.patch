@@ -267,12 +280,14 @@ def main() -> int:
                       "k_gap": args.k_gap, "subject_filter": args.subject_filter},
         "thresholds": {"min_precision": args.min_precision,
                        "min_separation": args.min_separation,
-                       "max_crowding": args.max_crowding},

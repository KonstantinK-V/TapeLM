 2 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/_stage280_raw_exam.py b/_stage280_raw_exam.py
index e56a331..8c81b0b 100644
--- a/_stage280_raw_exam.py
+++ b/_stage280_raw_exam.py
@@ -382,14 +382,26 @@ def return_path(pack, item, answered) -> float:
     if answered is None or "postings_probe" not in pack:
         return float("nan")
     words = context_words(answered) or [answered]
-    back, _ = s271.vote(words, pack["postings_probe"], pack["idf_probe"], 7)
+    # Exact, not ranked. This used to take the top 7 of a vote, and 283 measured what a fixed
+    # window does to a growing tape: the rate on true values fell 1.000 -> 0.885 -> 0.616 across
+    # a 52x growth in slots while the rate on values taken from elsewhere stayed at zero. The
+    # corroborating mention was not missing, it was pushed out of the window by slots that share
+    # the value's words. A slot that contains the whole value contains the value's rarest word,
+    # so scanning that word's posting list finds every one of them and no ranking is involved.
+    posts = pack["postings_probe"]
+    scan = min((posts.get(w, ()) for w in words), key=len, default=())
     val_lc = answered.lower()
     # Two distinct mentions, because one is the slot the answer was read from and a text cannot
     # corroborate itself. The probe index is the one that does not hide a slot's own value -
     # without it the words of a value can never reach the slot holding it and every return is a
     # miss by construction, which is how this measurement failed the first three times.
-    return float(sum(1 for c in back if item["S"] in pack["texts_lc"][c]
-                     and val_lc in pack["texts_lc"][c]) >= 2)
+    seen = 0
+    for c in scan:
+        if item["S"] in pack["texts_lc"][c] and val_lc in pack["texts_lc"][c]:
+            seen += 1
+            if seen >= 2:
+                return 1.0
+    return 0.0
 
 
 def main() -> int:
diff --git a/_stage283_scale.py b/_stage283_scale.py

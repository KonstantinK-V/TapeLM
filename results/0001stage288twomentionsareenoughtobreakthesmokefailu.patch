+            f"items {len(pack['items'])}, mentions-per-address {json.dumps(dict(sizes))}. "
+            f"Raise --addresses or lower --min-mentions.")
         return 1
 
     # ---------------------------------------------------------------- train: we break, it fixes
@@ -404,7 +413,7 @@ def main() -> int:
         restored_model, restored_votes = [], []

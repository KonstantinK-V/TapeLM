@@ -336,14 +336,23 @@ def main() -> int:
     n_params = int(sum(q.numel() for q in net.parameters()))
 
     def usable(p):
-        return [(it, s) for it in p["items"] if len(it["slots"]) >= 3 for s in it["slots"]]
+        # Two mentions is enough, and the smoke falling is what made that obvious. Requiring

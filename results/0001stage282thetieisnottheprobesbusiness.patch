+    if lead == second and not st.get("tie_probe"):
+        # Measured, twice, and it lost twice. The idea was that retrieval pollution invents
+        # false ties, so the return path should break them; at one witness the teacher resolved
+        # 45% of the held-out ties and its ceiling fell to 0.445, at two witnesses it resolved
+        # fewer and reached 0.533 - still below the 0.594 it scores when it never touches a tie
+        # at all. A tied address has no settled value, so every resolution can only be wrong,
+        # and the pollution the rule was built for is largely gone since --subject-filter
+        # started working. The probe keeps its job on the lead; the tie is not its business.
+        # --tie-probe restores the two-witness rule, which is the run these numbers come from.
+        return acts.STOP_CONFLICT
+
     if lead == second:
-        # A tie is where the return path is worth the most, and it was the one place the probe
-        # was never used. Retrieval brings foreign slots - precision runs 0.33-0.74 on raw text -
-        # and a foreign slot votes with a foreign value, so a clean address with one value can
-        # show 2-2 and be called a conflict. Ask both leaders before believing the tie: a value
-        # that leads back to the subject is a witness, one that does not is pollution. Only a
-        # tie among values that BOTH lead back (or neither) is a conflict the tape really has.
         for val in (ranked[0][0], ranked[1][0]):
             j = slot_of(val)
             if j is not None and st["ret_ok"].get(cands[j], -1.0) < 0 \
@@ -316,13 +321,14 @@ def teacher(pack, st, acts, item, max_steps, max_reads):
 

+    ids = [i for i in tok.encode(" | ".join(texts)[-2000:]).ids
+           if i != pad_id][-s177.MAX_ARCS:]
     if not ids:
         return None
     h, _ = hidden_and_logits(model, char_table,
@@ -279,12 +296,14 @@ def main() -> int:
